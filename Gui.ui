  <property name="styleSheet">
   <string notr="true">QMainWindow {
	background-color: #121212;
}
QGroupBox {
	font-weight: bold;
	color: #E0E0E0;
	border: 1px solid #2C2C2C;
	border-radius: 6px;
	margin-top: 12px;
	padding-top: 10px;
}
QGroupBox::title {
	subcontrol-origin: margin;
	subcontrol-position: top left;
	left: 10px;
	padding: 0 3px;
}
QLabel {
	color: #B0B0B0;
}
QProgressBar {
	border: 1px solid #2C2C2C;
	border-radius: 3px;
	background-color: #1A1A1A;
}
QProgressBar::chunk {
	background-color: #00E676; 
	width: 1px;
}
QProgressBar#gpuUsageProgressBar::chunk {
	background-color: #00ffff; 
}
QPushButton {
	background-color: #2C2C2C;
	color: #E0E0E0;
	border: 1px solid #444444;
	border-radius: 4px;
	padding: 6px 12px;
	font-weight: bold;
}
QPushButton:hover {
	background-color: #3D3D3D;
	border: 1px solid #EF5350; 
}
QPushButton:pressed {
	background-color: #1A1A1A;
}
QPushButton:disabled {
	background-color: #444444;
	color: #888888;
	border: 1px solid #3a3a3a;
}
QCheckBox {
	color: #B0B0B0;
	font-weight: bold;
	spacing: 6px;
}
QCheckBox::indicator {
	width: 14px;
	height: 14px;
	border: 1px solid #444444;
	border-radius: 3px;
	background-color: #1A1A1A;
}
QCheckBox::indicator:checked {
	background-color: #EF5350;
	border: 1px solid #EF5350;
}
QCheckBox::indicator:disabled {
	border: 1px solid #2C2C2C;
	background-color: #121212;
}
QCheckBox:disabled {
	color: #555555;
}
QSlider::groove:horizontal {
	border: 1px solid #2C2C2C;
	height: 6px;
	background: #1A1A1A;
	border-radius: 3px;
}
QSlider::handle:horizontal {
	background: #EF5350;
	border: 1px solid #EF5350;
	width: 14px;
	margin: -4px 0;
	border-radius: 7px;
}
QSlider::handle:horizontal:disabled {
	background: #555555;
	border: 1px solid #555555;
}
QSpinBox {
	background-color: #1A1A1A;
	color: #E0E0E0;
	border: 1px solid #2C2C2C;
	border-radius: 4px;
	padding: 4px;
}
QSpinBox:disabled {
	color: #555555;
	background-color: #121212;
}
</string>
