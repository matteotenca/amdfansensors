  <property name="styleSheet">
   <string notr="true">/* === Global Theme Variables === */
QMainWindow {
    background-color: #1E1E2E;
}

QWidget#GuiWindow {
    background-color: #1E1E2E;
}

/* === Group Boxes === */
QGroupBox {
    font-weight: bold;
    color: #CDD6F4;
    border: 1px solid #313244;
    border-radius: 2px;
    margin-top: 15px;
    padding-top: 16px;
    background-color: #181825;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 6px;
}

/* === Section Headers (Hardware, Tuning, Performance) === */
QGroupBox#m_hardwareGroup {
    border-color: #585B7A;
}

QGroupBox#m_controlGroup {
    border-color: #89DCEB;
}

QGroupBox#m_fpsGroup {
    border-color: #F9E2AF;
}

QGroupBox#m_refreshRateGroup {
    border-color: #CBA6F7;
}

/* === Labels === */
QLabel {
    color: #CAD6F4;
    font-family: 'Segoe UI', 'Cascadia Code', 'Consolas';
}

QLabel#m_gpuTempLabel, QLabel#m_hotspotTempLabel, QLabel#m_memTempLabel {
    color: #E78A00;
    font-weight: 600;
}

QLabel#m_systemMemoryLabel {
    color: #89DCEB;
    font-weight: 500;
}

QLabel#m_fanLabel {
    color: #A6E3A1;
    font-weight: 500;
}

QLabel#m_memoryLabel, QLabel#m_statusLabel {
    color: #F9E2AF;
    font-weight: 500;
}

QLabel#m_gpuUsageLabel {
    color: #89DCEB;
    font-weight: 600;
}

/* === FPS Labels === */
QLabel#m_instantFpsLabel {
    color: #CDD6F4;
    font-size: 14px;
    font-weight: bold;
}

QLabel#m_avgFpsLabel, QLabel#m_minMaxFpsLabel {
    color: #A6E3A1;
    font-size: 14px;
    font-weight: bold;
}

/* === Progress Bars === */
QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: #313244;
    height: 10px;
    text-align: center;
}

QProgressBar#m_fanBar::chunk {
    border-radius: 5px;
    background: qlineargradient(spread:reflect, x1:0, y1:0, x2:1, y2:0, stop:0 #A6E3A1, stop:1 #89DCEB);
}

QProgressBar#m_memoryBar::chunk {
    border-radius: 5px;
    background: qlineargradient(spread:reflect, x1:0, y1:0, x2:1, y2:0, stop:0 #F9E2AF, stop:1 #F5C2E7);
}

QProgressBar#m_systemMemoryBar::chunk {
    border-radius: 5px;
    background: qlineargradient(spread:reflect, x1:0, y1:0, x2:1, y2:0, stop:0 #89DCEB, stop:1 #89DCEB);
}

QProgressBar#gpuUsageProgressBar::chunk {
    border-radius: 5px;
    background: qlineargradient(spread:reflect, x1:0, y1:0, x2:1, y2:0, stop:0 #F38BA8, stop:1 #F9E2AF);
}

/* === Buttons === */
QPushButton {
    background-color: #313244;
    color: #CDD6F4;
    border: 1px solid #45475A;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #45475A;
    border-color: #CDD6F4;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #585B7A;
    color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #262730;
    color: #585B7A;
    border-color: #313244;
}

/* === Apply button special style === */
QPushButton#m_applyTuningButton {
    background-color: #89DCEB;
    color: #1E1E2E;
    border: none;
    font-weight: bold;
    padding: 10px 16px;
}

QPushButton#m_applyTuningButton:hover {
    background-color: #89DCEB;
    color: #1E1E2E;
}

QPushButton#m_applyTuningButton:pressed {
    background-color: #7DD3C4;
}

QPushButton#m_applyTuningButton:disabled {
    background-color: #313244;
    color: #585B7A;
}

/* === Checkboxes === */
QCheckBox {
    color: #CAD6F4;
    font-weight: 500;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    border: 2px solid #585B7A;
    background-color: #313244;
}

QCheckBox::indicator:checked {
    background-color: #89DCEB;
    border-color: #89DCEB;
}

QCheckBox::indicator:hover {
    border-color: #CDD6F4;
}

QCheckBox::indicator:disabled {
    border-color: #313244;
    background-color: #1E1E2E;
}

QCheckBox:disabled {
    color: #585B7A;
}

/* === Slider === */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: #313244;
    border-radius: 3px;
    margin: 0;
}

QSlider::add-page:horizontal {
    background: #313244;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #89DCEB, stop:1 #89DCEB);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    margin: -5px 0;
    border-radius: 8px;
    background: #CDD6F4;
    border: none;
}

QSlider::handle:hover:horizontal {
    background: #FFFFFF;
}

QSlider::handle:disabled:horizontal {
    background: #585B7A;
}

/* === SpinBox === */
QSpinBox {
    background-color: #313244;
    color: #CDD6F4;
    border: 1px solid #45475A;
    border-radius: 6px;
    padding: 6px 8px;
    font-family: 'Segoe UI', monospace;
    min-width: 80px;
}

QSpinBox:hover {
    border-color: #89DCEB;
}

QSpinBox:focus {
    border-color: #89DCEB;
    background-color: #3A3B4C;
}

/*QSpinBox::up-button, QSpinBox::down-button {*/
/*    background-color: transparent;*/
/*    border: none;*/
/*       *//*border: 3px solid #45475A;*/
/*    width: 15px;*/
/*}*/

/*QSpinBox::up-button:hover, QSpinBox::down-button:hover {*/
/*    background-color: #45475A;*/
/*background-color: transparent;*/
/*}*/

QSpinBox:disabled {
    color: #585B7A;
    background-color: #1E1E2E;
    border-color: #313244;
}</string>
